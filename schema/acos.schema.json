{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acos.dev/schema/0.1/manifest.json",
  "title": "ACOS Run Manifest",
  "description": "Agentic Coding Orchestration Schema, version 0.1. Describes how one agentic coding run will be executed, before any worker model spends tokens.",
  "type": "object",
  "required": [
    "acos",
    "id",
    "intent",
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "acos": {
      "type": "string",
      "const": "0.1",
      "description": "Schema version this manifest conforms to."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Run identifier. Generated by the orchestrator. Used as the run directory name."
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentence summary of what the user asked for."
    },
    "part": {
      "$ref": "#/$defs/Part"
    },
    "preset": {
      "type": "string",
      "description": "Name of the preset this manifest was derived from, if any."
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Stage"
      },
      "description": "Ordered list of stages. Executed in order."
    },
    "loop": {
      "$ref": "#/$defs/Loop"
    },
    "gates": {
      "$ref": "#/$defs/Gates"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "estimate": {
      "$ref": "#/$defs/Estimate"
    },
    "actual": {
      "$ref": "#/$defs/Estimate",
      "description": "Executed manifest only. Same shape as estimate, filled with what the run actually used."
    },
    "drift": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Drift"
      },
      "description": "Executed manifest only. Every difference between the planned manifest and what ran."
    },
    "outputs": {
      "$ref": "#/$defs/Outputs"
    }
  },
  "$defs": {
    "Adapter": {
      "type": "string",
      "enum": [
        "inline",
        "subagent",
        "workflow",
        "external"
      ],
      "description": "How a stage is executed. inline: the orchestrator does it in-session. subagent: a subagent of the same harness. workflow: the harness workflow engine. external: a shell command or API call to another provider."
    },
    "Effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "max"
      ],
      "description": "Provider-agnostic effort level. Adapters map it to provider-specific settings."
    },
    "OnFail": {
      "type": "string",
      "enum": [
        "retry",
        "escalate",
        "ask",
        "stop"
      ],
      "description": "What to do when a stage check fails."
    },
    "ModelRef": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        }
      }
    },
    "Scope": {
      "type": "object",
      "description": "Advisory hints about where the work is expected to happen. All fields optional.",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths the work is expected to touch."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths the work should not modify."
        },
        "notes": {
          "type": "string",
          "description": "Free-text constraints for all stages."
        }
      }
    },
    "Check": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "command",
            "review",
            "none"
          ]
        },
        "command": {
          "type": "string",
          "description": "Shell command. Exit code 0 means pass. Required when kind is command."
        },
        "criteria": {
          "type": "string",
          "description": "What a reviewer judges. Required when kind is review."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "review"
              }
            }
          },
          "then": {
            "required": [
              "criteria"
            ]
          }
        }
      ]
    },
    "Stage": {
      "type": "object",
      "required": [
        "name",
        "adapter"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "block"
          ]
        },
        {
          "required": [
            "role"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Unique within the manifest."
        },
        "block": {
          "type": "string",
          "description": "Catalog block this stage instantiates. Optional if role is given."
        },
        "role": {
          "type": "string",
          "description": "One line describing what this stage does. Required if block is absent."
        },
        "adapter": {
          "$ref": "#/$defs/Adapter"
        },
        "provider": {
          "type": "string",
          "description": "Catalog provider key. May be omitted when adapter is inline."
        },
        "model": {
          "type": "string",
          "description": "Provider model id. May be omitted when adapter is inline."
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of prior stage outputs this stage reads."
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of artifacts this stage produces."
        },
        "check": {
          "$ref": "#/$defs/Check"
        },
        "on_fail": {
          "$ref": "#/$defs/OnFail"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Overrides loop.max_iterations for this stage."
        },
        "escalation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelRef"
          },
          "description": "Ordered models to try when on_fail is escalate."
        },
        "gate": {
          "type": "boolean",
          "default": false,
          "description": "Pause for user confirmation before this stage runs."
        },
        "prompt": {
          "type": "string",
          "description": "Extra instructions appended to the block prompt for the worker."
        }
      }
    },
    "Loop": {
      "type": "object",
      "description": "Manifest-level loop defaults. Stage values override.",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "on_fail": {
          "$ref": "#/$defs/OnFail",
          "default": "retry"
        }
      }
    },
    "Gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "go": {
          "type": "string",
          "enum": [
            "required",
            "auto"
          ],
          "default": "required",
          "description": "required: wait for explicit GO. auto: only valid from project-level config, never from a preset."
        },
        "per_stage": {
          "type": "boolean",
          "default": false,
          "description": "Confirm before every stage."
        }
      }
    },
    "Estimate": {
      "type": "object",
      "description": "Rough compose-time estimate (or, as `actual`, what the run used). Every field optional.",
      "additionalProperties": false,
      "properties": {
        "orchestrator_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "worker_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "agents": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "per_stage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              },
              "cost": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "basis": {
          "type": "string",
          "description": "How the estimate was made."
        }
      }
    },
    "Outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_dir": {
          "type": "string",
          "description": "Where manifest and log are written. Default runs/<id>."
        },
        "write_log": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "Limits": {
      "type": "object",
      "description": "Advisory ceilings for one run. Act at compose time only: split large intents into a plan and cap delegation. Not checked mid-run; calibrate compares them with actual afterwards.",
      "additionalProperties": false,
      "properties": {
        "orchestrator_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Context the orchestrating session may spend."
        },
        "worker_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Sum over subagents, workflow agents and external calls."
        },
        "agents": {
          "type": "integer",
          "minimum": 0,
          "description": "Subagent, workflow agent or external calls per run."
        },
        "stages": {
          "type": "integer",
          "minimum": 1
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "default": "USD"
        }
      }
    },
    "Drift": {
      "type": "object",
      "required": [
        "at_stage",
        "change",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "at_stage": {
          "type": "string",
          "description": "Stage that was running when the change was made."
        },
        "change": {
          "type": "string",
          "description": "'path: old -> new', or 'stages[<name>]: added | dropped'."
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "Part": {
      "type": "object",
      "description": "Present when this manifest is one part of a plan (runs/<plan>/plan.yaml). Parts run in order, each in its own session.",
      "required": [
        "plan",
        "index",
        "of"
      ],
      "additionalProperties": false,
      "properties": {
        "plan": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Plan id; the plan file is runs/<plan>/plan.yaml."
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "of": {
          "type": "integer",
          "minimum": 1
        },
        "assumes": {
          "type": "string",
          "description": "What this part expects earlier parts to have left in the tree. Checked before GO."
        }
      }
    }
  }
}
